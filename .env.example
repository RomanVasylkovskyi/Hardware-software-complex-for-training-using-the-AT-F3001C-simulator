# ========================================================
# Hardware-software complex for training using the AT-F3001C simulator
# Environment Configuration (.env)
# ========================================================

# Host Port Mappings
GATEWAY_PORT=8000
TELEMETRY_PORT=8001
VISION_PORT=8002
ANALYTICS_PORT=8003
XPLANE_UDP_PORT=49000

# Flight Training Defaults
AIRPORT_ICAO=UKLL
RUNWAY_IDENT=13
AIRCRAFT_TYPE=Cessna 172SP G1000

# High-Frequency Streaming Configuration
BROADCAST_RATE_HZ=25
