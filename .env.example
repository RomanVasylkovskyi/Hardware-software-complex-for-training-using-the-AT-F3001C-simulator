# ========================================================
# Hardware-software complex for training using the AT-F3001C simulator
# Environment configuration. Copy to .env and adjust; .env is not committed.
# ========================================================

# Host ports (only these two are published; internal services stay on the Docker network)
GATEWAY_PORT=8000
XPLANE_UDP_PORT=49000

# Instructor token for replay/live/upload control. Leave empty only on an isolated dev machine.
INSTRUCTOR_TOKEN=

# Flight training defaults
AIRPORT_ICAO=UKLL
RUNWAY_IDENT=13
TARGET_IAS_KT=65
# true = stabilization gate at 500 ft (VFR circuits), false = 1000 ft (IMC)
APPROACH_IS_VMC=false

# Streaming: panel update cap (Hz) and telemetry push cap (Hz)
BROADCAST_RATE_HZ=30
TELEMETRY_MAX_RATE_HZ=50
